From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Polack <spolack+git@mailbox.org>
Subject: [PATCH] MIPS: Octeon: schedule for the OCTEON III pipeline

The kernel is compiled with -march=octeon for every OCTEON. Add
-mtune=octeon3: it only changes instruction scheduling, so the code
still runs on every OCTEON, and it is worth 10-18 % in packet-rate-bound
forwarding on the CN7030 of the EdgeRouter 4.

Signed-off-by: Simon Polack <spolack+git@mailbox.org>

--- a/arch/mips/Makefile
+++ b/arch/mips/Makefile
@@ -182,7 +182,7 @@ cflags-$(CONFIG_CPU_SB1)	+= $(call cc-op
 cflags-$(CONFIG_CPU_SB1)	+= $(call cc-option,-mno-mips3d)
 cflags-$(CONFIG_CPU_R10000)	+= $(call cc-option,-march=r10000,-march=mips4) \
 			-Wa,--trap
-cflags-$(CONFIG_CPU_CAVIUM_OCTEON) += -march=octeon -Wa,--trap
+cflags-$(CONFIG_CPU_CAVIUM_OCTEON) += -march=octeon -mtune=octeon3 -Wa,--trap
 cflags-$(CONFIG_CAVIUM_CN63XXP1) += -Wa,-mfix-cn63xxp1
 cflags-$(CONFIG_CPU_BMIPS)	+= -march=mips32 -Wa,--trap
 
