From: Simon Polack <spolack+git@mailbox.org>
Subject: [PATCH] MIPS: Octeon: log the bootloader's packet I/O registers (test images only)

Not for upstream: test images log the GMX, PCS, PIP, IPD and PKO
registers before any driver probes, for remote debugging.

Signed-off-by: Simon Polack <spolack+git@mailbox.org>
---
--- a/arch/mips/cavium-octeon/Makefile	2026-10-25 15:26:32.202327874 +0100
+++ b/arch/mips/cavium-octeon/Makefile	2026-10-25 15:26:32.205555484 +0100
@@ -13,6 +13,7 @@
 obj-y += dma-octeon.o
 obj-y += octeon-crypto.o
 obj-y += octeon-memcpy.o
+obj-y += octeon-bootregs.o
 obj-y += executive/
 
 obj-$(CONFIG_MTD)		      += flash_setup.o
--- a/arch/mips/cavium-octeon/octeon-bootregs.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/mips/cavium-octeon/octeon-bootregs.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Test images only: log the packet I/O registers as the bootloader left
+ * them, before any driver probes (arch_initcall runs before the
+ * device_initcall of the Ethernet drivers). Only the blocks of the
+ * interfaces the chip reports in use are read. One line per register:
+ *
+ *   octeon-bootregs: <name> <interface>.<index> <address> <value>
+ */
+
+#include <linux/bits.h>
+#include <linux/init.h>
+#include <linux/printk.h>
+
+#include <asm/octeon/octeon.h>
+#include <asm/octeon/cvmx-helper.h>
+#include <asm/octeon/cvmx-asxx-defs.h>
+#include <asm/octeon/cvmx-fpa-defs.h>
+#include <asm/octeon/cvmx-gmxx-defs.h>
+#include <asm/octeon/cvmx-ipd-defs.h>
+#include <asm/octeon/cvmx-pcsx-defs.h>
+#include <asm/octeon/cvmx-pcsxx-defs.h>
+#include <asm/octeon/cvmx-pip-defs.h>
+#include <asm/octeon/cvmx-pko-defs.h>
+
+static void __init bootreg(const char *name, int iface, int index, u64 addr)
+{
+	pr_info("octeon-bootregs: %-16s %d.%d %#014llx %#018llx\n", name,
+		iface, index, addr & GENMASK_ULL(48, 0), cvmx_read_csr(addr));
+}
+
+#define BOOTREG(reg, i, x)	bootreg(#reg, i, x, CVMX_##reg)
+
+static bool __init has_asx(void)
+{
+	return OCTEON_IS_MODEL(OCTEON_CN3XXX) ||
+	       OCTEON_IS_MODEL(OCTEON_CN50XX) ||
+	       OCTEON_IS_MODEL(OCTEON_CN58XX);
+}
+
+static void __init bootregs_gmx_port(int i, int x)
+{
+	bootreg("GMX_PRT_CFG", i, x, CVMX_GMXX_PRTX_CFG(x, i));
+	bootreg("GMX_RX_FRM_CTL", i, x, CVMX_GMXX_RXX_FRM_CTL(x, i));
+	bootreg("GMX_RX_JABBER", i, x, CVMX_GMXX_RXX_JABBER(x, i));
+	bootreg("GMX_RX_ADR_CTL", i, x, CVMX_GMXX_RXX_ADR_CTL(x, i));
+	bootreg("GMX_RX_INT_REG", i, x, CVMX_GMXX_RXX_INT_REG(x, i));
+}
+
+static void __init bootregs_pcs_port(int i, int x)
+{
+	bootreg("PCS_MR_CONTROL", i, x, CVMX_PCSX_MRX_CONTROL_REG(x, i));
+	bootreg("PCS_MR_STATUS", i, x, CVMX_PCSX_MRX_STATUS_REG(x, i));
+	bootreg("PCS_AN_ADV", i, x, CVMX_PCSX_ANX_ADV_REG(x, i));
+	bootreg("PCS_AN_LP_ABIL", i, x, CVMX_PCSX_ANX_LP_ABIL_REG(x, i));
+	bootreg("PCS_AN_RESULTS", i, x, CVMX_PCSX_ANX_RESULTS_REG(x, i));
+	bootreg("PCS_MISC_CTL", i, x, CVMX_PCSX_MISCX_CTL_REG(x, i));
+	bootreg("PCS_INT", i, x, CVMX_PCSX_INTX_REG(x, i));
+}
+
+static int __init octeon_bootregs(void)
+{
+	int i, x, port, n = cvmx_helper_get_number_of_interfaces();
+	int mode;	/* an enum, with and without a tag across kernels */
+
+	pr_info("octeon-bootregs: begin chip %#x interfaces %d\n",
+		read_c0_prid(), n);
+	BOOTREG(IPD_CTL_STATUS, -1, -1);
+	BOOTREG(PKO_REG_FLAGS, -1, -1);
+	BOOTREG(FPA_CTL_STATUS, -1, -1);
+	BOOTREG(PIP_GBL_CTL, -1, -1);
+	BOOTREG(PIP_GBL_CFG, -1, -1);
+	for (i = 0; i < n; i++) {
+		mode = cvmx_helper_interface_get_mode(i);
+		pr_info("octeon-bootregs: interface %d mode %d\n", i, mode);
+		switch (mode) {
+		case CVMX_HELPER_INTERFACE_MODE_SGMII:
+		case CVMX_HELPER_INTERFACE_MODE_PICMG:
+			bootreg("GMX_INF_MODE", i, -1, CVMX_GMXX_INF_MODE(i));
+			for (x = 0; x < 4; x++) {
+				bootregs_gmx_port(i, x);
+				bootregs_pcs_port(i, x);
+			}
+			break;
+		case CVMX_HELPER_INTERFACE_MODE_RGMII:
+		case CVMX_HELPER_INTERFACE_MODE_GMII:
+			bootreg("GMX_INF_MODE", i, -1, CVMX_GMXX_INF_MODE(i));
+			for (x = 0; x < (OCTEON_IS_MODEL(OCTEON_CN50XX) ? 3 : 4);
+			     x++)
+				bootregs_gmx_port(i, x);
+			if (has_asx()) {
+				bootreg("ASX_RX_PRT_EN", i, -1,
+					CVMX_ASXX_RX_PRT_EN(i));
+				bootreg("ASX_TX_PRT_EN", i, -1,
+					CVMX_ASXX_TX_PRT_EN(i));
+			}
+			break;
+		case CVMX_HELPER_INTERFACE_MODE_XAUI:
+			bootreg("GMX_INF_MODE", i, -1, CVMX_GMXX_INF_MODE(i));
+			bootregs_gmx_port(i, 0);
+			bootreg("PCSX_CONTROL1", i, -1,
+				CVMX_PCSXX_CONTROL1_REG(i));
+			bootreg("PCSX_STATUS1", i, -1, CVMX_PCSXX_STATUS1_REG(i));
+			bootreg("PCSX_STATUS2", i, -1, CVMX_PCSXX_STATUS2_REG(i));
+			bootreg("PCSX_INT", i, -1, CVMX_PCSXX_INT_REG(i));
+			break;
+		default:
+			break;
+		}
+	}
+	/* The parser setup of every input port the bootloader touched */
+	for (port = 0; port < 48; port++) {
+		u64 cfg = cvmx_read_csr(CVMX_PIP_PRT_CFGX(port));
+		u64 tag = cvmx_read_csr(CVMX_PIP_PRT_TAGX(port));
+
+		if (cfg || tag) {
+			bootreg("PIP_PRT_CFG", -1, port, CVMX_PIP_PRT_CFGX(port));
+			bootreg("PIP_PRT_TAG", -1, port, CVMX_PIP_PRT_TAGX(port));
+		}
+	}
+	pr_info("octeon-bootregs: end\n");
+	return 0;
+}
+arch_initcall(octeon_bootregs);
