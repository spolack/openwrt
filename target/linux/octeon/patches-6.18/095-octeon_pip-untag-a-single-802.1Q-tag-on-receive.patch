From: Simon Polack <spolack+git@mailbox.org>
Subject: [PATCH] octeon_pip: untag a single 802.1Q tag on receive (NETIF_F_HW_VLAN_CTAG_RX)

The PIP parses the VLAN tag of a frame (WQE word 2: VLAN_VALID, VLAN_STACKED) but the driver left the tag in the frame: GRO walked the offload list twice per packet (dev_gro_receive for 8021Q, vlan_gro_receive for the IP offload: vlan_gro_receive 3.3 % of the forwarding core on the EdgeRouter 4 with a tagged 64 byte flood, 95 cycles per packet) and the stack untagged the list head in software (skb_vlan_untag, a memmove per list).

Take a single 802.1Q tag out of the frame before eth_type_trans(): the TPID and the full TCI from the frame (the WQE has no priority bits), the MAC addresses moved up by four bytes with three word loads before the first store, the tag into the skb (__vlan_hwaccel_put_tag). GRO then takes the IP packet directly and the stack's vlan_do_receive() delivers to the VLAN device as before. What stays in software: stacked tags and other TPIDs (802.1ad: the frame is left alone, NETIF_F_HW_VLAN_STAG_RX is not advertised), the transmit side's tag insertion (the PKO inserts no tags; NETIF_F_HW_VLAN_CTAG_TX is not advertised), and the XDP and pktgen paths (XDP sees the raw frame; a program that rewrote it does not match the TPID test). The PIP's L4 checksum verdict holds, the tag's bytes are outside the L3/L4 sums. ethtool -K <port> rx-vlan-offload off restores the old behaviour.

Signed-off-by: Simon Polack <spolack+git@mailbox.org>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
--- a/drivers/net/ethernet/cavium/octeon/octeon_pip_hw.h
+++ b/drivers/net/ethernet/cavium/octeon/octeon_pip_hw.h
@@ -279,6 +279,9 @@ struct opip_wqe {
 
 /* word2: how the packet was parsed and stored */
 #define OPIP_WQE2_BUFS		GENMASK_ULL(63, 56)
+/* The PIP found a VLAN (or DSA) tag in the L2 header, two if stacked */
+#define OPIP_WQE2_VLAN_VALID	BIT_ULL(47)
+#define OPIP_WQE2_VLAN_STACKED	BIT_ULL(46)
 #define OPIP_WQE2_TCP_OR_UDP	BIT_ULL(18)
 #define OPIP_WQE2_IS_V6		BIT_ULL(16)
 #define OPIP_WQE2_L4_ERROR	BIT_ULL(14)
--- a/drivers/net/ethernet/cavium/octeon/octeon_pip_main.c
+++ b/drivers/net/ethernet/cavium/octeon/octeon_pip_main.c
@@ -1178,6 +1178,9 @@ static struct net_device *opip_alloc_por
 			   NETIF_F_IPV6_CSUM | NETIF_F_RXCSUM | NETIF_F_RXHASH;
 	dev->features |= dev->hw_features;
 	dev->vlan_features |= dev->hw_features;
+	/* The receive untag of a single 802.1Q tag, see opip_rx_vlan_untag() */
+	dev->hw_features |= NETIF_F_HW_VLAN_CTAG_RX;
+	dev->features |= NETIF_F_HW_VLAN_CTAG_RX;
 	dev->hw_enc_features = NETIF_F_SG | NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM;
 	xdp_set_features_flag(dev, NETDEV_XDP_ACT_BASIC |
 			      NETDEV_XDP_ACT_REDIRECT |
--- a/drivers/net/ethernet/cavium/octeon/octeon_pip_rx.c
+++ b/drivers/net/ethernet/cavium/octeon/octeon_pip_rx.c
@@ -20,6 +20,7 @@
 #include <linux/skbuff_ref.h>
 #include <linux/slab.h>
 #include <linux/smp.h>
+#include <linux/unaligned.h>
 #include <linux/workqueue.h>
 #include <net/page_pool/helpers.h>
 #include <net/xdp.h>
@@ -529,6 +530,39 @@ static struct sk_buff *opip_rx_copy_skb(
 	return skb;
 }
 
+/*
+ * A single 802.1Q tag out of the frame into the skb (NETIF_F_HW_VLAN_CTAG_RX)
+ * before the stack sees the frame: the PIP found the tag (WQE word 2),
+ * the frame holds the TPID and the full TCI. The MAC addresses move up
+ * by the tag's four bytes (three words, loaded before the first store),
+ * the stack's GRO then takes the IP packet straight away instead of
+ * walking the offload list twice (vlan_gro_receive) and the per-list
+ * skb_vlan_untag() goes. Stacked tags and other TPIDs (802.1ad) stay in
+ * the frame for the stack's software untag; the transmit side inserts
+ * tags in software as before (the PKO inserts none). The PIP's checksum
+ * verdict holds (the tag's bytes are outside the L3/L4 sums).
+ * Always inline: per packet.
+ */
+static __always_inline void opip_rx_vlan_untag(struct sk_buff *skb)
+{
+	u8 *data = skb->data;
+	u32 a, b, c;
+	u16 tci;
+
+	if (get_unaligned((__be16 *)(data + 2 * ETH_ALEN)) !=
+	    htons(ETH_P_8021Q))
+		return;
+	tci = ntohs(get_unaligned((__be16 *)(data + 2 * ETH_ALEN + 2)));
+	a = get_unaligned((u32 *)data);
+	b = get_unaligned((u32 *)(data + 4));
+	c = get_unaligned((u32 *)(data + 8));
+	put_unaligned(a, (u32 *)(data + 4));
+	put_unaligned(b, (u32 *)(data + 8));
+	put_unaligned(c, (u32 *)(data + 12));
+	__skb_pull(skb, VLAN_HLEN);
+	__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q), tci);
+}
+
 /* Always inline: with two callers gcc calls it out of line, per packet */
 static __always_inline void opip_rx_deliver(struct opip_group *group,
 					    struct net_device *dev,
@@ -541,6 +575,10 @@ static __always_inline void opip_rx_deli
 
 	/* A port has a receive queue per group, as XDP has */
 	skb_record_rx_queue(skb, group->group);
+	if (likely(features & NETIF_F_HW_VLAN_CTAG_RX) &&
+	    (wqe->word2 & (OPIP_WQE2_VLAN_VALID | OPIP_WQE2_VLAN_STACKED)) ==
+	    OPIP_WQE2_VLAN_VALID && skb->len >= VLAN_ETH_HLEN)
+		opip_rx_vlan_untag(skb);
 	skb->protocol = eth_type_trans(skb, dev);
 	/*
 	 * The PIP's flow tag of an IP packet is the stack's flow hash: GRO
