 	"tx_no_wqe",
 	"tx_no_chunk",
+	"tx_list_geometry",
+	"tx_list_shared",
 	/*
 	 * Error events, not frames: the times the periodic worker found the
 	 * bit set, see opip_poll_errors()
@@ -77,6 +79,7 @@ static void opip_get_ethtool_stats(struc
 				   struct ethtool_stats *stats, u64 *data)
 {
 	u64 linearized = 0, no_wqe = 0, no_chunk = 0;
+	u64 list_geometry = 0, list_shared = 0;
 	struct opip_port *p = opip_port(dev);
 	unsigned int qid;
 	int i = 0;
@@ -87,10 +90,14 @@ static void opip_get_ethtool_stats(struc
 		linearized += READ_ONCE(q->linearized);
 		no_wqe += READ_ONCE(q->no_wqe);
 		no_chunk += READ_ONCE(q->no_chunk);
+		list_geometry += READ_ONCE(q->list_geometry);
+		list_shared += READ_ONCE(q->list_shared);
 	}
