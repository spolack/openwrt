+.text
+.set	reorder
+.set	noat
+.globl	chacha_crypt_arch
+.ent	chacha_crypt_arch
+chacha_crypt_arch:
+	.frame	$sp, STACK_SIZE, $ra
+
+	move	$at, $8
+
+	PTR_ADDIU $sp, -STACK_SIZE
+
+	/* Return bytes = 0. */
+	beqz	BYTES, .Lchacha_mips_end
+
+	lw	NONCE_0, 48(STATE)
+
+	/* Save s0-s8 and ra, which serve as temporaries */
+	LONG_S	$s0, (0 * LONGSIZE)($sp)
+	LONG_S	$s1, (1 * LONGSIZE)($sp)
+	LONG_S	$s2, (2 * LONGSIZE)($sp)
+	LONG_S	$s3, (3 * LONGSIZE)($sp)
+	LONG_S	$s4, (4 * LONGSIZE)($sp)
+	LONG_S	$s5, (5 * LONGSIZE)($sp)
+	LONG_S	$s6, (6 * LONGSIZE)($sp)
+	LONG_S	$s7, (7 * LONGSIZE)($sp)
+	LONG_S	$s8, (8 * LONGSIZE)($sp)
+	LONG_S	$ra, RA_OFF($sp)
+
+#ifdef FULL_UNROLL
+	/* nrounds - 20 (0 or -8) stays in $at, $8 becomes X0 */
+	addiu	$at, -20
+#else
+	/* Keep nrounds, $8 becomes X0 */
+	LONG_S	$at, NROUNDS_OFF($sp)
+#endif
+
+#ifdef XT_EPILOGUE
+	/*
+	 * IS_UNALIGNED is kept for the whole call: 0 when IN and OUT are 8-byte
+	 * aligned, -1 when both are 4 mod 8 (the in-place IPv4 WireGuard
+	 * payload), otherwise the two misalignments (positive).
+	 */
+	andi	IS_UNALIGNED, IN, 0x7
+	ins	IS_UNALIGNED, OUT, 3, 3
+	xori	T0, IS_UNALIGNED, 0x24
+	li	T1, -1
+	movz	IS_UNALIGNED, T1, T0
+#else
+	/* Test IN or OUT is unaligned for 64-bit accesses */
+	or	IS_UNALIGNED, IN, OUT
+	andi	IS_UNALIGNED, 0x7
+#endif
+
+	lw	X0,  0(STATE)
+	lw	X1,  4(STATE)
+	lw	X2,  8(STATE)
+	lw	X3,  12(STATE)
+	lw	X4,  16(STATE)
+	lw	X5,  20(STATE)
+	lw	X6,  24(STATE)
+	lw	X7,  28(STATE)
+	lw	X8,  32(STATE)
+	lw	X9,  36(STATE)
+	lw	X10, 40(STATE)
+	lw	X11, 44(STATE)
+	move	X12, NONCE_0
+	lw	X13, 52(STATE)
+	lw	X14, 56(STATE)
+	lw	X15, 60(STATE)
+
+.align 4
+.Loop_chacha_rounds:
+	PREFETCH_NEXT
+#ifdef FULL_UNROLL
+	/* All rounds unrolled; 12 rounds ($at = nrounds - 20 != 0) start at the fifth double round */
+	.set	noreorder
+	bnez	$at, .Lchacha_rounds_12
+	 addiu	BYTES, -(CHACHA20_BLOCK_SIZE)
+	.set	reorder
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+.Lchacha_rounds_12:
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+#else
+	/* Four rounds per iteration, nrounds is 20 or 12 */
+	addiu	$at, -4
+	DOUBLE_ROUND
+	DOUBLE_ROUND
+	bnez	$at, .Loop_chacha_rounds
+	addiu	BYTES, -(CHACHA20_BLOCK_SIZE)
+#endif
+
+	/* Is data src/dst unaligned? Jump */
+	bnez	IS_UNALIGNED, .Loop_chacha_unaligned
+
+	/* BYTES < 0, it has no full block; the delay slot holds a temp load. */
+	.set	noreorder
+	bltz	BYTES, .Lchacha_mips_tail
+	 EPILOGUE_ALIGNED_0
+	.set	reorder
+
+	EPILOGUE_ALIGNED
+
+	/* BYTES > 0? Loop again. */
+	bgtz	BYTES, .Loop_chacha_rounds
+
+.Lchacha_mips_xor_done:
+	/* Write NONCE_0 back to right location in state */
+	sw	NONCE_0, 48(STATE)
+
+.Lchacha_mips_restore:
+	LONG_L	$s0, (0 * LONGSIZE)($sp)
+	LONG_L	$s1, (1 * LONGSIZE)($sp)
+	LONG_L	$s2, (2 * LONGSIZE)($sp)
+	LONG_L	$s3, (3 * LONGSIZE)($sp)
+	LONG_L	$s4, (4 * LONGSIZE)($sp)
+	LONG_L	$s5, (5 * LONGSIZE)($sp)
+	LONG_L	$s6, (6 * LONGSIZE)($sp)
+	LONG_L	$s7, (7 * LONGSIZE)($sp)
+	LONG_L	$s8, (8 * LONGSIZE)($sp)
+	LONG_L	$ra, RA_OFF($sp)
+
+.Lchacha_mips_end:
+	PTR_ADDIU $sp, STACK_SIZE
+	jr	$ra
+
+.Loop_chacha_unaligned:
+#ifdef XT_EPILOGUE
+	/* IN and OUT both 4 mod 8: words 1..14 as 8-byte aligned pairs */
+	.set	noreorder
+	bgez	IS_UNALIGNED, .Loop_chacha_generic
+	 EPILOGUE_MID4_0
+	bltz	BYTES, .Lchacha_mips_tail
+	 EPILOGUE_MID4_0
+	.set	reorder
+
+	EPILOGUE_MID4
+
+	bgtz	BYTES, .Loop_chacha_rounds
+
+	b	.Lchacha_mips_xor_done
+
+.Loop_chacha_generic:
+#endif
+	/* BYTES < 0, it has no full block. */
+	.set	noreorder
+	bltz	BYTES, .Lchacha_mips_tail
+	 EPILOGUE_UNALIGNED_0
+	.set	reorder
+
+	EPILOGUE_UNALIGNED
+
+	/* BYTES > 0? Loop again. */
+	bgtz	BYTES, .Loop_chacha_rounds
+
+	b	.Lchacha_mips_xor_done
+
+.Lchacha_mips_tail:
+	/* Restore the offset on BYTES: 1..63 bytes left */
+	addiu	BYTES, CHACHA20_BLOCK_SIZE
+
+	/* Keystream of this block to the stack, NONCE_0 += 1 */
+	EPILOGUE_KEYSTREAM
+
+	sw	NONCE_0, 48(STATE)
+
+	PTR_ADDIU TA0, $sp, KS_OFF
+
+	/* Full words first */
+	andi	TB0, BYTES, MASK_U32
+	beqz	TB0, .Lchacha_mips_tail_bytes
+
+.Lchacha_mips_tail_words:
+	lw	TD0, 0(TA0)
+	lwl	TD1, MSB(IN)
+	lwr	TD1, LSB(IN)
+	addiu	TB0, -4
+	xor	TD1, TD0
+	swl	TD1, MSB(OUT)
+	swr	TD1, LSB(OUT)
+	PTR_ADDIU TA0, 4
+	PTR_ADDIU IN, 4
+	PTR_ADDIU OUT, 4
+	bnez	TB0, .Lchacha_mips_tail_words
+
+.Lchacha_mips_tail_bytes:
+	andi	TB0, BYTES, 0x3
