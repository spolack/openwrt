+	sd	X9, 16(OUT); \
+	addu	X8, NONCE_0, X12; \
+	lw	X10, 52(STATE); \
+	subu	X3, X11, X3; \
+	lw	TB0, 28(STATE); \
+	addu	TA0, TA0, X6; \
+	lw	TB1, 56(STATE); \
+	subu	X6, TA0, X6; \
+	ld	TD1, 48(IN); \
+	addu	X10, X10, X13; \
+	lw	X9, 60(STATE); \
+	addu	TB0, TB0, X7; \
+	addu	TB1, TB1, X14; \
+	subu	X7, TB0, X7; \
+	dinsu	X8, X10, 32, 32; \
+	ld	X11, 24(IN); \
+	xor	X8, X8, TD1; \
+	dinsu	TA0, TB0, 32, 32; \
+	subu	X14, TB1, X14; \
+	addu	X9, X9, X15; \
+	ld	TB0, 56(IN); \
+	dinsu	TB1, X9, 32, 32; \
+	sd	X8, 48(OUT); \
+	xor	TA0, TA0, X11; \
+	lw	X11, 44(STATE); \
+	xor	TB1, TB1, TB0; \
+	subu	X13, X10, X13; \
+	sd	TB1, 56(OUT); \
+	subu	X15, X9, X15; \
+	lw	X10, 40(STATE); \
+	lw	X8, 32(STATE); \
+	sd	TA0, 24(OUT); \
+	lw	X9, 36(STATE); \
+	addiu	X12, NONCE_0, 1; \
+	PTR_ADDIU IN, CHACHA20_BLOCK_SIZE; \
+	PTR_ADDIU OUT, CHACHA20_BLOCK_SIZE; \
+	addiu	NONCE_0, 1
+
+/* EPILOGUE_UNALIGNED: 98 instructions, 57 cycles on the model */
+#define EPILOGUE_UNALIGNED_0 lw	TB0, 36(STATE)
+#define EPILOGUE_UNALIGNED \
+	ldl	TB1, 32+MSB64(IN); \
+	lw	TA0, 32(STATE); \
+	addu	TB0, TB0, X9; \
+	ldl	X9, 40+MSB64(IN); \
+	ldr	TB1, 32+LSB64(IN); \
+	addu	TA0, TA0, X8; \
+	lw	TD1, 40(STATE); \
+	lw	X8, 44(STATE); \
+	dinsu	TA0, TB0, 32, 32; \
+	ldr	X9, 40+LSB64(IN); \
+	xor	TA0, TA0, TB1; \
+	addu	TD1, TD1, X10; \
+	lw	TB1, 4(STATE); \
+	addu	X8, X8, X11; \
+	sdr	TA0, 32+LSB64(OUT); \
+	lw	TB0, 0(STATE); \
+	dinsu	TD1, X8, 32, 32; \
+	sdl	TA0, 32+MSB64(OUT); \
+	xor	TD1, TD1, X9; \
+	ldl	TA0, 0+MSB64(IN); \
+	addu	TB1, TB1, X1; \
+	sdr	TD1, 40+LSB64(OUT); \
+	addu	TB0, TB0, X0; \
+	lw	X9, 16(STATE); \
+	subu	X1, TB1, X1; \
+	sdl	TD1, 40+MSB64(OUT); \
+	subu	X0, TB0, X0; \
+	dinsu	TB0, TB1, 32, 32; \
+	lw	TD1, 20(STATE); \
+	ldr	TA0, 0+LSB64(IN); \
+	addu	X9, X9, X4; \
+	ldl	TB1, 16+MSB64(IN); \
+	subu	X4, X9, X4; \
+	ldl	X8, 8+MSB64(IN); \
+	addu	TD1, TD1, X5; \
+	lw	X11, 12(STATE); \
+	xor	TB0, TB0, TA0; \
+	lw	X10, 8(STATE); \
+	dinsu	X9, TD1, 32, 32; \
+	ldr	TB1, 16+LSB64(IN); \
+	subu	X5, TD1, X5; \
+	addu	X11, X11, X3; \
+	ldr	X8, 8+LSB64(IN); \
+	addu	X10, X10, X2; \
+	sdl	TB0, 0+MSB64(OUT); \
+	subu	X2, X10, X2; \
+	dinsu	X10, X11, 32, 32; \
+	xor	X9, X9, TB1; \
+	sdr	TB0, 0+LSB64(OUT); \
+	xor	X10, X10, X8; \
+	lw	TA0, 24(STATE); \
+	sdr	X9, 16+LSB64(OUT); \
+	subu	X3, X11, X3; \
+	lw	TB0, 28(STATE); \
+	addu	X8, NONCE_0, X12; \
+	sdl	X9, 16+MSB64(OUT); \
+	addu	TA0, TA0, X6; \
+	sdl	X10, 8+MSB64(OUT); \
+	subu	X6, TA0, X6; \
+	sdr	X10, 8+LSB64(OUT); \
+	addu	TB0, TB0, X7; \
+	lw	X9, 60(STATE); \
+	subu	X7, TB0, X7; \
+	ldl	TD1, 48+MSB64(IN); \
+	dinsu	TA0, TB0, 32, 32; \
+	lw	TB1, 56(STATE); \
+	lw	X10, 52(STATE); \
+	addu	X9, X9, X15; \
+	ldl	X11, 24+MSB64(IN); \
+	addu	TB1, TB1, X14; \
+	ldr	TD1, 48+LSB64(IN); \
+	ldl	TB0, 56+MSB64(IN); \
+	subu	X14, TB1, X14; \
+	ldr	X11, 24+LSB64(IN); \
+	addu	X10, X10, X13; \
+	dinsu	TB1, X9, 32, 32; \
+	dinsu	X8, X10, 32, 32; \
+	ldr	TB0, 56+LSB64(IN); \
+	xor	X8, X8, TD1; \
+	xor	TA0, TA0, X11; \
+	sdl	X8, 48+MSB64(OUT); \
+	subu	X13, X10, X13; \
+	sdr	X8, 48+LSB64(OUT); \
+	xor	TB1, TB1, TB0; \
+	lw	X11, 44(STATE); \
+	subu	X15, X9, X15; \
+	sdl	TB1, 56+MSB64(OUT); \
+	addiu	X12, NONCE_0, 1; \
+	lw	X8, 32(STATE); \
+	lw	X10, 40(STATE); \
+	sdl	TA0, 24+MSB64(OUT); \
+	lw	X9, 36(STATE); \
+	sdr	TB1, 56+LSB64(OUT); \
+	sdr	TA0, 24+LSB64(OUT); \
+	addiu	NONCE_0, 1; \
+	PTR_ADDIU OUT, CHACHA20_BLOCK_SIZE; \
+	PTR_ADDIU IN, CHACHA20_BLOCK_SIZE
+
+/* EPILOGUE_KEYSTREAM: 48 instructions, 26 cycles on the model */
+#define EPILOGUE_KEYSTREAM \
+	lw	TB1, 12(STATE); \
+	addu	X12, X12, NONCE_0; \
+	lw	TA1, 8(STATE); \
+	addiu	NONCE_0, 1; \
+	lw	TB0, 4(STATE); \
+	lw	TA0, 0(STATE); \
+	addu	X3, X3, TB1; \
+	addu	X2, X2, TA1; \
+	lw	TA1, 24(STATE); \
+	addu	X1, X1, TB0; \
+	lw	TB1, 28(STATE); \
+	lw	TB0, 20(STATE); \
+	addu	X0, X0, TA0; \
+	lw	TA0, 16(STATE); \
+	addu	X6, X6, TA1; \
+	lw	TA1, 56(STATE); \
+	addu	X7, X7, TB1; \
+	addu	X5, X5, TB0; \
+	lw	TB0, 52(STATE); \
+	lw	TB1, 60(STATE); \
+	addu	X4, X4, TA0; \
+	addu	X14, X14, TA1; \
+	lw	TA0, 32(STATE); \
+	addu	X13, X13, TB0; \
+	lw	TB0, 36(STATE); \
+	addu	X15, X15, TB1; \
+	lw	TA1, 40(STATE); \
+	lw	TB1, 44(STATE); \
+	dinsu	X0, X1, 32, 32; \
+	addu	X9, X9, TB0; \
+	dinsu	X14, X15, 32, 32; \
+	addu	X8, X8, TA0; \
+	dinsu	X4, X5, 32, 32; \
+	dinsu	X8, X9, 32, 32; \
+	dinsu	X6, X7, 32, 32; \
+	addu	X11, X11, TB1; \
+	sd	X14, (KS_OFF + 56)($sp); \
+	sd	X0, (KS_OFF + 0)($sp); \
+	dinsu	X12, X13, 32, 32; \
+	sd	X6, (KS_OFF + 24)($sp); \
+	addu	X10, X10, TA1; \
+	sd	X12, (KS_OFF + 48)($sp); \
+	dinsu	X2, X3, 32, 32; \
+	sd	X4, (KS_OFF + 16)($sp); \
+	dinsu	X10, X11, 32, 32; \
+	sd	X8, (KS_OFF + 32)($sp); \
+	sd	X2, (KS_OFF + 8)($sp); \
+	sd	X10, (KS_OFF + 40)($sp)
+
+/* EPILOGUE_MID4: 84 instructions, 49 cycles on the model */
+#define EPILOGUE_MID4_0 lw	TA0, 36(STATE)
+#define EPILOGUE_MID4 \
+	lw	TB0, 40(STATE); \
+	ld	TB1, 36(IN); \
+	addu	TA0, TA0, X9; \
+	lw	TD1, 44(STATE); \
+	addu	TB0, TB0, X10; \
+	ld	X10, 44(IN); \
+	dinsu	TA0, TB0, 32, 32; \
+	lw	TB0, 28(STATE); \
+	xor	TA0, TA0, TB1; \
+	lw	TB1, 32(STATE); \
+	sd	TA0, 36(OUT); \
+	addu	TD1, TD1, X11; \
+	addu	TB0, TB0, X7; \
+	addu	X9, NONCE_0, X12; \
+	ld	TA0, 28(IN); \
+	dinsu	TD1, X9, 32, 32; \
+	xor	TD1, TD1, X10; \
+	addu	TB1, TB1, X8; \
+	subu	X7, TB0, X7; \
+	sd	TD1, 44(OUT); \
+	lw	X11, 4(STATE); \
+	dinsu	TB0, TB1, 32, 32; \
+	xor	TB0, TB0, TA0; \
+	lw	X9, 8(STATE); \
+	lw	TD1, 12(STATE); \
+	addiu	X12, NONCE_0, 1; \
+	sd	TB0, 28(OUT); \
+	addu	X11, X11, X1; \
+	lw	X8, 16(STATE); \
+	addu	X9, X9, X2; \
+	lw	TA0, 20(STATE); \
+	addu	TD1, TD1, X3; \
+	subu	X1, X11, X1; \
+	ld	TB1, 12(IN); \
+	subu	X2, X9, X2; \
+	lw	TB0, 24(STATE); \
+	dinsu	X11, X9, 32, 32; \
+	ld	X10, 4(IN); \
+	addu	X8, X8, X4; \
+	subu	X3, TD1, X3; \
+	addu	TA0, TA0, X5; \
+	ld	X9, 20(IN); \
+	dinsu	TD1, X8, 32, 32; \
+	subu	X5, TA0, X5; \
+	xor	TD1, TD1, TB1; \
+	addu	TB0, TB0, X6; \
+	sd	TD1, 12(OUT); \
+	dinsu	TA0, TB0, 32, 32; \
+	xor	X11, X11, X10; \
+	xor	TA0, TA0, X9; \
+	sd	X11, 4(OUT); \
+	subu	X4, X8, X4; \
+	lw	X10, 52(STATE); \
+	subu	X6, TB0, X6; \
+	sd	TA0, 20(OUT); \
+	lw	TD1, 60(STATE); \
+	lw	X11, 56(STATE); \
+	addu	X10, X10, X13; \
+	lw	TB1, 0(STATE); \
+	subu	X13, X10, X13; \
+	ld	X8, 52(IN); \
+	addu	TD1, TD1, X15; \
+	lw	TA0, 60(IN); \
+	addu	X11, X11, X14; \
+	lw	TB0, 0(IN); \
+	dinsu	X10, X11, 32, 32; \
+	subu	X15, TD1, X15; \
+	xor	X10, X10, X8; \
+	addu	TB1, TB1, X0; \
+	sd	X10, 52(OUT); \
+	subu	X0, TB1, X0; \
+	xor	TD1, TD1, TA0; \
+	subu	X14, X11, X14; \
+	xor	TB1, TB1, TB0; \
+	lw	X11, 44(STATE); \
+	sw	TB1, 0(OUT); \
+	sw	TD1, 60(OUT); \
+	lw	X10, 40(STATE); \
+	lw	X8, 32(STATE); \
+	lw	X9, 36(STATE); \
+	PTR_ADDIU IN, CHACHA20_BLOCK_SIZE; \
+	PTR_ADDIU OUT, CHACHA20_BLOCK_SIZE; \
+	addiu	NONCE_0, 1
+
+#endif
+
+#define DOUBLE_ROUND \
+	AXR( 0, 1, 2, 3,  4, 5, 6, 7, 12,13,14,15, 16); \
+	AXR( 8, 9,10,11, 12,13,14,15,  4, 5, 6, 7, 12); \
+	AXR( 0, 1, 2, 3,  4, 5, 6, 7, 12,13,14,15,  8); \
+	AXR( 8, 9,10,11, 12,13,14,15,  4, 5, 6, 7,  7); \
+	AXR( 0, 1, 2, 3,  5, 6, 7, 4, 15,12,13,14, 16); \
+	AXR(10,11, 8, 9, 15,12,13,14,  5, 6, 7, 4, 12); \
+	AXR( 0, 1, 2, 3,  5, 6, 7, 4, 15,12,13,14,  8); \
+	AXR(10,11, 8, 9, 15,12,13,14,  5, 6, 7, 4,  7);
