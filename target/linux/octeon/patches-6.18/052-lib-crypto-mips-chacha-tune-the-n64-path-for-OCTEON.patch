From: Simon Polack <spolack+git@mailbox.org>
Subject: [PATCH] lib/crypto: mips/chacha - tune the 64-bit path for the OCTEON pipeline

Rework the n64 body of chacha-core.S for the in-order dual-issue cnMIPS
cores (o32 stays byte-identical):

- the keystream epilogue works on 64-bit word pairs: K = X + S for both
  words into temporaries, dinsu packs them, dsbh + dshd byte-swaps the
  doubleword (the little-endian serialisation of the pair), one
  ld/xor/sd per pair, X restored as K - X instead of a second state load;
- the rounds are fully unrolled, 12-round calls enter at the fifth
  double round; nrounds-20 stays in $at and the alignment class in s7;
- pref 0, 64(IN) at the block top makes the data-cold pass as fast as
  the hot loop;
- a third data path for IN and OUT both 4 mod 8 (the in-place WireGuard
  payload in one direction of an IPv4 tunnel: outer IP + 44 against the
  inner IP header), 102 instructions per block instead of 114 for
  ldl/ldr; branch-free alignment classification at entry;
- the last partial block never touches memory beyond the length: the
  keystream goes to the stack and is wiped.

Measured on a CN7030 (EdgeRouter 4, 1 GHz), one core, cycles per byte:

                     64 B    256 B   1024 B   1420 B   4096 B
  before (n64)      10.56   10.30   10.18    10.48    10.15
  after             9.16    8.60    8.43     8.74     8.39

(-16.6 % at 1420 B hot; data cold 9.6 -> 8.5 at 1 KiB).  13232 test
cases (every length up to ~600 and a set of long ones, all IN/OUT
offsets 0..7, in place, 20 and 12 rounds, guard bytes) pass on qemu n64
big and little endian, qemu o32 and the CN7030; the crypto self-tests
pass.  Only MIPS64r2 instructions are used (dinsu, dsbh, dshd, ins,
movz), so the path is not OCTEON-specific.

Signed-off-by: Simon Polack <spolack+git@mailbox.org>
---
--- a/lib/crypto/mips/chacha-core.S
+++ b/lib/crypto/mips/chacha-core.S
@@ -19,8 +19,11 @@
  * by number.
  */
 #if (_MIPS_SIM == _MIPS_SIM_ABI64)
-#define STACK_SIZE		(8 * LONGSIZE + 2 * LONGSIZE)
-#define NROUNDS_OFF		(8 * LONGSIZE)
+/* s0-s8, ra, nrounds, pad, keystream of the last block */
+#define STACK_SIZE		(12 * LONGSIZE + CHACHA20_BLOCK_SIZE)
+#define RA_OFF			(9 * LONGSIZE)
+#define NROUNDS_OFF		(10 * LONGSIZE)
+#define KS_OFF			(12 * LONGSIZE)
 #else
 #define STACK_SIZE		32
 #define NROUNDS_OFF		(STACK_SIZE + 16)
@@ -235,6 +238,1014 @@ CONCAT3(.Lchacha_mips_xor_aligned_, PLUS
 	jr	T0
 #endif
 
+#if (_MIPS_SIM == _MIPS_SIM_ABI64)
+/*
+ * 64-bit path, tuned for the OCTEON III core (2-wide in-order issue, one
+ * memory access per cycle, load-use latency 3): the rounds run at the issue
+ * limit (2 instructions per cycle, 483 cycles per block on a CN7030), so
+ * everything else is about instruction count.
+ *
+ * The rounds are the same as on o32 and are fully unrolled (FULL_UNROLL):
+ * the loop version costs a taken branch and a counter per 4 rounds.
+ * 12-round calls (XChaCha) enter at the fifth double round.
+ *
+ * The per-block epilogue works on word pairs: the two keystream words K =
+ * X + S are computed into temporaries, packed into one 64-bit register
+ * (dinsu), byte-swapped together (dsbh + dshd is a 64-bit byte swap, which
+ * with the second word in the upper half yields the little-endian
+ * serialisation of both words), xored with one 64-bit load of the data and
+ * stored with one 64-bit store.  X is restored to S for the next block as
+ * K - X (no second state load).  The pairs holding X8-X11 go first without
+ * that restore: the next block's first AXR group does not read them, so
+ * they serve as temporaries for the other pairs (three pairs in flight,
+ * which hides the load latency) and are reloaded last (XT_EPILOGUE).  The
+ * instruction order of the epilogues was produced by gen_epi.py (a list
+ * scheduler with the measured OCTEON III latencies); the next block's data
+ * is prefetched during the rounds (PREFETCH_NEXT).
+ *
+ * Three data alignments are handled: IN and OUT 8-byte aligned (ld/sd),
+ * both 4 mod 8 (the in-place IPv4 WireGuard payload: words 1..14 as
+ * 8-byte aligned pairs, words 0 and 15 with lw/sw) and anything else
+ * (ldl/ldr, sdl/sdr).  The last partial block writes its keystream to the
+ * stack and xors it word- and byte-wise, the buffer is cleared afterwards.
+ */
+
+/* Temporaries of the epilogue ($at and s7 only on the exit path). */
+#define TA0		T0
+#define TB0		T1
+#define TD0		$at
+#define TA1		$s7
+#define TB1		$s8
+#define TD1		$ra
+
+#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define MSB64 0
+#define LSB64 7
+#else
+#define MSB64 7
+#define LSB64 0
+#endif
+
+#define FULL_UNROLL
+#define XT_EPILOGUE
+#define PREFETCH_NEXT pref 0, 64(IN)
+
+#ifndef PREFETCH_NEXT
+#define PREFETCH_NEXT
+#endif
+
+/* Generated by gen_epi.py sub xt, do not edit by hand. */
+#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+/* EPILOGUE_ALIGNED: 98 instructions, 56 cycles on the model */
+#define EPILOGUE_ALIGNED_0 lw	TA0, 32(STATE)
+#define EPILOGUE_ALIGNED \
+	lw	TD1, 40(STATE); \
+	lw	TB0, 36(STATE); \
+	addu	TA0, TA0, X8; \
+	lw	X8, 44(STATE); \
+	addu	TD1, TD1, X10; \
+	ld	TB1, 32(IN); \
+	addu	TB0, TB0, X9; \
+	ld	X9, 40(IN); \
+	addu	X8, X8, X11; \
+	dinsu	TA0, TB0, 32, 32; \
+	dinsu	TD1, X8, 32, 32; \
+	lw	X10, 8(STATE); \
+	dsbh	TD1, TD1; \
+	dsbh	TA0, TA0; \
+	dshd	TD1, TD1; \
+	lw	X11, 12(STATE); \
+	xor	TD1, TD1, X9; \
+	dshd	TA0, TA0; \
+	sd	TD1, 40(OUT); \
+	xor	TA0, TA0, TB1; \
+	lw	X9, 16(STATE); \
+	addu	X10, X10, X2; \
+	lw	TB1, 4(STATE); \
+	addu	X11, X11, X3; \
+	lw	TB0, 0(STATE); \
+	subu	X2, X10, X2; \
+	lw	TD1, 20(STATE); \
+	addu	X9, X9, X4; \
+	ld	X8, 8(IN); \
+	dinsu	X10, X11, 32, 32; \
+	addu	TB0, TB0, X0; \
+	dsbh	X10, X10; \
+	sd	TA0, 32(OUT); \
+	subu	X4, X9, X4; \
+	addu	TD1, TD1, X5; \
+	addu	TB1, TB1, X1; \
+	dshd	X10, X10; \
+	subu	X0, TB0, X0; \
+	dinsu	TB0, TB1, 32, 32; \
+	subu	X1, TB1, X1; \
+	xor	X10, X10, X8; \
+	dinsu	X9, TD1, 32, 32; \
+	ld	TB1, 16(IN); \
+	dsbh	TB0, TB0; \
+	sd	X10, 8(OUT); \
+	dsbh	X9, X9; \
+	ld	TA0, 0(IN); \
+	dshd	X9, X9; \
+	xor	X9, X9, TB1; \
+	lw	X10, 52(STATE); \
+	dshd	TB0, TB0; \
+	addu	X8, NONCE_0, X12; \
+	xor	TB0, TB0, TA0; \
+	sd	X9, 16(OUT); \
+	subu	X5, TD1, X5; \
+	addu	X10, X10, X13; \
+	sd	TB0, 0(OUT); \
+	dinsu	X8, X10, 32, 32; \
+	lw	TA0, 24(STATE); \
+	dsbh	X8, X8; \
+	ld	TD1, 48(IN); \
+	dshd	X8, X8; \
+	lw	X9, 60(STATE); \
+	subu	X3, X11, X3; \
+	lw	TB1, 56(STATE); \
+	addu	TA0, TA0, X6; \
+	lw	TB0, 28(STATE); \
+	xor	X8, X8, TD1; \
+	addu	X9, X9, X15; \
+	subu	X6, TA0, X6; \
+	addu	TB1, TB1, X14; \
+	ld	X11, 24(IN); \
+	addu	TB0, TB0, X7; \
+	subu	X14, TB1, X14; \
+	subu	X7, TB0, X7; \
+	dinsu	TA0, TB0, 32, 32; \
+	sd	X8, 48(OUT); \
+	dinsu	TB1, X9, 32, 32; \
+	ld	TB0, 56(IN); \
+	dsbh	TA0, TA0; \
+	dsbh	TB1, TB1; \
+	dshd	TA0, TA0; \
+	dshd	TB1, TB1; \
+	xor	TA0, TA0, X11; \
+	subu	X15, X9, X15; \
+	lw	X8, 32(STATE); \
+	subu	X13, X10, X13; \
+	addiu	X12, NONCE_0, 1; \
+	xor	TB1, TB1, TB0; \
+	lw	X11, 44(STATE); \
+	lw	X9, 36(STATE); \
+	sd	TB1, 56(OUT); \
+	lw	X10, 40(STATE); \
+	sd	TA0, 24(OUT); \
+	addiu	NONCE_0, 1; \
+	PTR_ADDIU OUT, CHACHA20_BLOCK_SIZE; \
+	PTR_ADDIU IN, CHACHA20_BLOCK_SIZE
+
+/* EPILOGUE_UNALIGNED: 114 instructions, 64 cycles on the model */
+#define EPILOGUE_UNALIGNED_0 lw	TB0, 36(STATE)
+#define EPILOGUE_UNALIGNED \
+	lw	TA0, 32(STATE); \
+	ldl	TB1, 32+MSB64(IN); \
+	lw	TD1, 40(STATE); \
+	addu	TB0, TB0, X9; \
+	addu	TA0, TA0, X8; \
+	lw	X8, 44(STATE); \
+	ldl	X9, 40+MSB64(IN); \
+	dinsu	TA0, TB0, 32, 32; \
+	ldr	TB1, 32+LSB64(IN); \
+	addu	TD1, TD1, X10; \
+	lw	TB0, 0(STATE); \
+	dsbh	TA0, TA0; \
+	addu	X8, X8, X11; \
+	dshd	TA0, TA0; \
+	ldr	X9, 40+LSB64(IN); \
+	xor	TA0, TA0, TB1; \
+	dinsu	TD1, X8, 32, 32; \
+	lw	TB1, 4(STATE); \
+	sdl	TA0, 32+MSB64(OUT); \
+	dsbh	TD1, TD1; \
+	sdr	TA0, 32+LSB64(OUT); \
+	addu	TB0, TB0, X0; \
+	dshd	TD1, TD1; \
+	lw	X10, 8(STATE); \
+	xor	TD1, TD1, X9; \
+	subu	X0, TB0, X0; \
+	ldl	TA0, 0+MSB64(IN); \
+	addu	TB1, TB1, X1; \
+	sdl	TD1, 40+MSB64(OUT); \
+	dinsu	TB0, TB1, 32, 32; \
+	lw	X11, 12(STATE); \
+	addu	X10, X10, X2; \
+	sdr	TD1, 40+LSB64(OUT); \
+	dsbh	TB0, TB0; \
+	ldl	X8, 8+MSB64(IN); \
+	subu	X2, X10, X2; \
+	ldr	TA0, 0+LSB64(IN); \
+	subu	X1, TB1, X1; \
+	lw	TD1, 20(STATE); \
+	dshd	TB0, TB0; \
+	lw	X9, 16(STATE); \
+	addu	X11, X11, X3; \
+	ldl	TB1, 16+MSB64(IN); \
+	dinsu	X10, X11, 32, 32; \
+	ldr	X8, 8+LSB64(IN); \
+	xor	TB0, TB0, TA0; \
+	sdl	TB0, 0+MSB64(OUT); \
+	dsbh	X10, X10; \
+	addu	X9, X9, X4; \
+	sdr	TB0, 0+LSB64(OUT); \
+	addu	TD1, TD1, X5; \
+	dshd	X10, X10; \
+	subu	X4, X9, X4; \
+	xor	X10, X10, X8; \
+	ldr	TB1, 16+LSB64(IN); \
+	dinsu	X9, TD1, 32, 32; \
+	lw	TA0, 24(STATE); \
+	dsbh	X9, X9; \
+	lw	TB0, 28(STATE); \
+	dshd	X9, X9; \
+	sdl	X10, 8+MSB64(OUT); \
+	subu	X5, TD1, X5; \
+	sdr	X10, 8+LSB64(OUT); \
+	addu	TA0, TA0, X6; \
+	xor	X9, X9, TB1; \
+	addu	TB0, TB0, X7; \
+	subu	X6, TA0, X6; \
+	sdr	X9, 16+LSB64(OUT); \
+	sdl	X9, 16+MSB64(OUT); \
+	dinsu	TA0, TB0, 32, 32; \
+	ldl	TD1, 48+MSB64(IN); \
+	subu	X7, TB0, X7; \
+	lw	X10, 52(STATE); \
+	subu	X3, X11, X3; \
+	ldl	X11, 24+MSB64(IN); \
+	addu	X8, NONCE_0, X12; \
+	lw	X9, 60(STATE); \
+	dsbh	TA0, TA0; \
+	ldl	TB0, 56+MSB64(IN); \
+	addu	X10, X10, X13; \
+	lw	TB1, 56(STATE); \
+	dinsu	X8, X10, 32, 32; \
+	ldr	TD1, 48+LSB64(IN); \
+	addu	X9, X9, X15; \
+	dsbh	X8, X8; \
+	ldr	X11, 24+LSB64(IN); \
+	addu	TB1, TB1, X14; \
+	ldr	TB0, 56+LSB64(IN); \
+	subu	X14, TB1, X14; \
+	dinsu	TB1, X9, 32, 32; \
+	dshd	X8, X8; \
+	dsbh	TB1, TB1; \
+	xor	X8, X8, TD1; \
+	dshd	TA0, TA0; \
+	dshd	TB1, TB1; \
+	xor	TA0, TA0, X11; \
+	sdl	X8, 48+MSB64(OUT); \
+	xor	TB1, TB1, TB0; \
+	sdr	X8, 48+LSB64(OUT); \
+	subu	X13, X10, X13; \
+	subu	X15, X9, X15; \
+	lw	X11, 44(STATE); \
+	sdl	TA0, 24+MSB64(OUT); \
+	sdr	TB1, 56+LSB64(OUT); \
+	lw	X10, 40(STATE); \
+	sdl	TB1, 56+MSB64(OUT); \
+	addiu	X12, NONCE_0, 1; \
+	lw	X8, 32(STATE); \
+	sdr	TA0, 24+LSB64(OUT); \
+	lw	X9, 36(STATE); \
+	PTR_ADDIU IN, CHACHA20_BLOCK_SIZE; \
+	PTR_ADDIU OUT, CHACHA20_BLOCK_SIZE; \
+	addiu	NONCE_0, 1
+
+/* EPILOGUE_KEYSTREAM: 64 instructions, 34 cycles on the model */
+#define EPILOGUE_KEYSTREAM \
+	lw	TA1, 8(STATE); \
+	addu	X12, X12, NONCE_0; \
+	lw	TB1, 12(STATE); \
+	addiu	NONCE_0, 1; \
+	lw	TB0, 4(STATE); \
+	addu	X2, X2, TA1; \
+	lw	TA1, 24(STATE); \
+	addu	X3, X3, TB1; \
+	lw	TA0, 0(STATE); \
+	addu	X1, X1, TB0; \
+	lw	TB0, 20(STATE); \
+	lw	TB1, 28(STATE); \
+	addu	X6, X6, TA1; \
+	lw	TA1, 56(STATE); \
+	addu	X0, X0, TA0; \
+	addu	X5, X5, TB0; \
+	lw	TA0, 16(STATE); \
+	addu	X7, X7, TB1; \
+	lw	TB0, 52(STATE); \
+	lw	TB1, 60(STATE); \
+	addu	X14, X14, TA1; \
+	addu	X4, X4, TA0; \
+	lw	TA0, 32(STATE); \
+	addu	X13, X13, TB0; \
+	lw	TA1, 40(STATE); \
+	addu	X15, X15, TB1; \
+	lw	TB0, 36(STATE); \
+	lw	TB1, 44(STATE); \
+	addu	X8, X8, TA0; \
+	dinsu	X0, X1, 32, 32; \
+	addu	X10, X10, TA1; \
+	addu	X9, X9, TB0; \
+	dsbh	X0, X0; \
+	addu	X11, X11, TB1; \
+	dinsu	X8, X9, 32, 32; \
+	dsbh	X8, X8; \
+	dinsu	X10, X11, 32, 32; \
+	dinsu	X4, X5, 32, 32; \
+	dinsu	X14, X15, 32, 32; \
+	dsbh	X10, X10; \
+	dinsu	X6, X7, 32, 32; \
+	dsbh	X4, X4; \
+	dshd	X8, X8; \
+	dsbh	X14, X14; \
+	dsbh	X6, X6; \
+	dshd	X0, X0; \
+	dshd	X14, X14; \
+	dshd	X10, X10; \
+	dinsu	X2, X3, 32, 32; \
+	dshd	X4, X4; \
+	dshd	X6, X6; \
+	sd	X8, (KS_OFF + 32)($sp); \
+	dsbh	X2, X2; \
+	dshd	X2, X2; \
+	sd	X0, (KS_OFF + 0)($sp); \
+	sd	X2, (KS_OFF + 8)($sp); \
+	dinsu	X12, X13, 32, 32; \
+	sd	X14, (KS_OFF + 56)($sp); \
+	dsbh	X12, X12; \
+	sd	X6, (KS_OFF + 24)($sp); \
+	dshd	X12, X12; \
+	sd	X10, (KS_OFF + 40)($sp); \
+	sd	X4, (KS_OFF + 16)($sp); \
+	sd	X12, (KS_OFF + 48)($sp)
+
+/* EPILOGUE_MID4: 102 instructions, 58 cycles on the model */
+#define EPILOGUE_MID4_0 lw	TA0, 36(STATE)
+#define EPILOGUE_MID4 \
+	lw	TB0, 40(STATE); \
+	ld	TB1, 36(IN); \
+	addu	TA0, TA0, X9; \
+	lw	TD1, 44(STATE); \
+	addu	TB0, TB0, X10; \
+	addu	X9, NONCE_0, X12; \
+	dinsu	TA0, TB0, 32, 32; \
+	lw	TB0, 28(STATE); \
+	dsbh	TA0, TA0; \
+	addu	TD1, TD1, X11; \
+	dshd	TA0, TA0; \
+	dinsu	TD1, X9, 32, 32; \
+	xor	TA0, TA0, TB1; \
+	lw	TB1, 32(STATE); \
+	sd	TA0, 36(OUT); \
+	addu	TB0, TB0, X7; \
+	ld	X10, 44(IN); \
+	subu	X7, TB0, X7; \
+	addu	TB1, TB1, X8; \
+	ld	TA0, 28(IN); \
+	dinsu	TB0, TB1, 32, 32; \
+	dsbh	TD1, TD1; \
+	dsbh	TB0, TB0; \
+	dshd	TD1, TD1; \
+	xor	TD1, TD1, X10; \
+	lw	X11, 4(STATE); \
+	dshd	TB0, TB0; \
+	sd	TD1, 44(OUT); \
+	xor	TB0, TB0, TA0; \
+	lw	X9, 8(STATE); \
+	sd	TB0, 28(OUT); \
+	addu	X11, X11, X1; \
+	lw	TD1, 12(STATE); \
+	subu	X1, X11, X1; \
+	addu	X9, X9, X2; \
+	lw	TA0, 20(STATE); \
+	lw	TB0, 24(STATE); \
+	dinsu	X11, X9, 32, 32; \
+	lw	X8, 16(STATE); \
+	dsbh	X11, X11; \
+	ld	X10, 4(IN); \
+	addu	TD1, TD1, X3; \
+	dshd	X11, X11; \
+	addu	TA0, TA0, X5; \
+	subu	X3, TD1, X3; \
+	addu	X8, X8, X4; \
+	xor	X11, X11, X10; \
+	subu	X2, X9, X2; \
+	ld	TB1, 12(IN); \
+	addu	TB0, TB0, X6; \
+	subu	X5, TA0, X5; \
+	dinsu	TD1, X8, 32, 32; \
+	sd	X11, 4(OUT); \
+	dinsu	TA0, TB0, 32, 32; \
+	ld	X9, 20(IN); \
+	dsbh	TD1, TD1; \
+	dshd	TD1, TD1; \
+	lw	X10, 52(STATE); \
+	dsbh	TA0, TA0; \
+	xor	TD1, TD1, TB1; \
+	sd	TD1, 12(OUT); \
+	dshd	TA0, TA0; \
+	lw	X11, 56(STATE); \
+	xor	TA0, TA0, X9; \
+	addu	X10, X10, X13; \
+	subu	X4, X8, X4; \
+	lw	TD1, 60(STATE); \
+	subu	X13, X10, X13; \
+	sd	TA0, 20(OUT); \
+	addu	X11, X11, X14; \
+	ld	X8, 52(IN); \
+	dinsu	X10, X11, 32, 32; \
+	lw	TB1, 0(STATE); \
+	addu	TD1, TD1, X15; \
+	dsbh	X10, X10; \
+	subu	X15, TD1, X15; \
+	dshd	X10, X10; \
+	lw	TA0, 60(IN); \
+	addu	TB1, TB1, X0; \
+	wsbh	TD1, TD1; \
+	subu	X0, TB1, X0; \
+	xor	X10, X10, X8; \
+	subu	X6, TB0, X6; \
+	wsbh	TB1, TB1; \
+	sd	X10, 52(OUT); \
+	rotr	TD1, TD1, 16; \
+	lw	TB0, 0(IN); \
+	rotr	TB1, TB1, 16; \
+	xor	TD1, TD1, TA0; \
+	subu	X14, X11, X14; \
+	lw	X11, 44(STATE); \
+	xor	TB1, TB1, TB0; \
+	sw	TD1, 60(OUT); \
+	lw	X10, 40(STATE); \
+	lw	X8, 32(STATE); \
+	sw	TB1, 0(OUT); \
+	lw	X9, 36(STATE); \
+	addiu	X12, NONCE_0, 1; \
+	PTR_ADDIU IN, CHACHA20_BLOCK_SIZE; \
+	PTR_ADDIU OUT, CHACHA20_BLOCK_SIZE; \
+	addiu	NONCE_0, 1
+
+#else
+/* EPILOGUE_ALIGNED: 82 instructions, 48 cycles on the model */
+#define EPILOGUE_ALIGNED_0 lw	TA0, 32(STATE)
+#define EPILOGUE_ALIGNED \
+	lw	TB0, 36(STATE); \
+	ld	TB1, 32(IN); \
+	addu	TA0, TA0, X8; \
+	lw	X8, 44(STATE); \
+	addu	TB0, TB0, X9; \
+	lw	TD1, 40(STATE); \
+	ld	X9, 40(IN); \
+	dinsu	TA0, TB0, 32, 32; \
+	xor	TA0, TA0, TB1; \
+	lw	TB0, 0(STATE); \
+	addu	X8, X8, X11; \
+	lw	TB1, 4(STATE); \
+	addu	TD1, TD1, X10; \
+	sd	TA0, 32(OUT); \
+	dinsu	TD1, X8, 32, 32; \
+	addu	TB0, TB0, X0; \
+	xor	TD1, TD1, X9; \
+	lw	X10, 8(STATE); \
+	sd	TD1, 40(OUT); \
+	subu	X0, TB0, X0; \
+	lw	X9, 16(STATE); \
+	addu	TB1, TB1, X1; \
+	lw	X11, 12(STATE); \
+	dinsu	TB0, TB1, 32, 32; \
+	lw	TD1, 20(STATE); \
+	subu	X1, TB1, X1; \
+	ld	TA0, 0(IN); \
+	addu	X10, X10, X2; \
+	ld	X8, 8(IN); \
+	addu	X9, X9, X4; \
