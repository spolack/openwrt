+	addu	TD1, TD1, X5; \
+	subu	X4, X9, X4; \
+	xor	X10, X10, X8; \
+	xor	TB0, TB0, TA0; \
+	dinsu	X9, TD1, 32, 32; \
+	sd	X10, 8(OUT); \
+	sd	TB0, 0(OUT); \
+	xor	X9, X9, TB1; \
+	lw	TA0, 24(STATE); \
