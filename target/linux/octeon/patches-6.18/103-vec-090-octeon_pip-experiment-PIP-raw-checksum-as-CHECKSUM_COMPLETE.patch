From: Simon Polack <spolack+git@mailbox.org>
Subject: [PATCH] octeon_pip: experiment: the PIP's raw checksum as CHECKSUM_COMPLETE

The PIP computes a 16 bit one's complement checksum for every packet (WQE word 0 bits 63:48, "raw chksum result generated by the HW" in cvmx-wqe.h); the driver ignores it. For the packets whose L4 checksum the PIP does not verify (GRE, IPIP: not TCP or UDP at the outer level) the stack sums the inner payload itself: csum_partial() is 5.7 % of the GRE decap core (1423 cycles per 1448 byte segment on image P2). With the raw sum as CHECKSUM_COMPLETE the inner checksum is validated from it (GRO: NAPI_GRO_CB(skb)->csum, the pulls of the GRE header adjust it), no csum_partial().

What the sum covers is not in the WQE header. Module parameter hw_csum_complete (0 off, default): 1 logs the raw sum of the first 16 unverified IP packets next to the sums of three candidate ranges (from the MAC header, from the IP header, from the IP payload; also the complement), 2/3/4 use it as CHECKSUM_COMPLETE assuming the IP header / MAC header / IP payload range, +8 if the hardware stores the complement. Probe first (echo 1 > /sys/module/octeon_pip/parameters/hw_csum_complete during a GRE run, dmesg), then set the matching mode and compare GRE tcp1; the GRE test also validates it (a wrong mode drops every inner TCP segment as bad checksum: netstat -s InCsumErrors). Not for the series as is: the probe code and the parameter go, the matching range stays.

Signed-off-by: Simon Polack <spolack+git@mailbox.org>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
--- a/drivers/net/ethernet/cavium/octeon/octeon_pip_hw.h
+++ b/drivers/net/ethernet/cavium/octeon/octeon_pip_hw.h
@@ -271,6 +271,8 @@ struct opip_wqe {
 
 /* word0 on the chips with port kinds (CN68XX) */
 #define OPIP_WQE0_PKND		GENMASK_ULL(5, 0)
+/* word0: the PIP's raw 16 bit one's complement checksum of the packet */
+#define OPIP_WQE0_HW_CHKSUM	GENMASK_ULL(63, 48)
 
 /* word1: length, tag, and on the older chips the input port */
 #define OPIP_WQE1_LEN		GENMASK_ULL(63, 48)
--- a/drivers/net/ethernet/cavium/octeon/octeon_pip_rx.c
+++ b/drivers/net/ethernet/cavium/octeon/octeon_pip_rx.c
@@ -11,7 +11,10 @@
 #include <linux/cpumask.h>
 #include <linux/etherdevice.h>
 #include <linux/filter.h>
+#include <linux/if_vlan.h>
 #include <linux/interrupt.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
 #include <linux/kernel.h>
 #include <linux/net.h>
 #include <linux/netdevice.h>
@@ -529,6 +532,93 @@ static struct sk_buff *opip_rx_copy_skb(
 	return skb;
 }
 
+/*
+ * Experiment: the PIP's raw checksum (WQE word 0 bits 63:48, a 16 bit
+ * one's complement sum the hardware computes for every packet) as
+ * CHECKSUM_COMPLETE for the packets whose L4 checksum the PIP did not
+ * verify (tunnels: GRE, IPIP; the stack then validates the inner TCP or
+ * UDP checksum from it instead of summing the payload in csum_partial(),
+ * 5.7 % of the GRE decap core). What the sum covers is not documented
+ * in the WQE header; hw_csum_complete=1 logs the sum against the sums
+ * of three ranges for the first packets so that the right mode can be
+ * set: 2 = the sum covers the packet from the IP header, 3 = from the
+ * MAC header, 4 = from the IP payload; + 8 = the hardware stores the
+ * complement. 0 (default) = off.
+ */
+static int opip_hw_csum_complete;
+module_param_named(hw_csum_complete, opip_hw_csum_complete, int, 0644);
+MODULE_PARM_DESC(hw_csum_complete,
+		 "PIP raw checksum as CHECKSUM_COMPLETE: 0 off, 1 probe, 2-4 (+8) mode");
+
+static noinline void opip_rx_csum_complete(const struct opip_wqe *wqe,
+					   struct sk_buff *skb)
+{
+	int mode = READ_ONCE(opip_hw_csum_complete);
+	unsigned int nhoff = 0, ihl = 0;
+	const u8 *nh;
+	__wsum hw;
+
+	if (!skb_mac_header_was_set(skb))
+		return;
+	/* A VLAN tag is still in the data (the stack pulls it, rcsum) */
+	if (eth_type_vlan(skb->protocol))
+		nhoff = VLAN_HLEN;
+	if (skb->len < nhoff + sizeof(struct iphdr))
+		return;
+	/* The range of a plain header: IPv4 by its ihl, IPv6 fixed */
+	nh = skb->data + nhoff;
+	if ((nh[0] >> 4) == 4)
+		ihl = (nh[0] & 0xf) * 4;
+	else if ((nh[0] >> 4) == 6)
+		ihl = sizeof(struct ipv6hdr);
+	if (!ihl || nhoff + ihl > skb->len)
+		return;
+
+	hw = (__force __wsum)FIELD_GET(OPIP_WQE0_HW_CHKSUM, wqe->word0);
+	if (mode & 8)
+		hw = (__force __wsum)(~(__force u32)hw & 0xffff);
+
+	switch (mode & 7) {
+	case 1: {
+		static atomic_t probes = ATOMIC_INIT(0);
+		__wsum l3, l2, l4;
+
+		if (atomic_inc_return(&probes) > 16)
+			return;
+		l3 = csum_partial(nh, skb->len - nhoff, 0);
+		l2 = csum_add(l3, csum_partial(skb_mac_header(skb),
+					       nh - skb_mac_header(skb), 0));
+		l4 = csum_sub(l3, csum_partial(nh, ihl, 0));
+		pr_info("octeon_pip csum probe: hw %04x (~%04x) len %u vlan %u ihl %u proto %u: l2 %04x l3 %04x l4 %04x\n",
+			(__force u32)hw, ~(__force u32)hw & 0xffff, skb->len,
+			nhoff, ihl, nh[ihl == sizeof(struct ipv6hdr) ? 6 : 9],
+			(__force u32)~csum_fold(l2) & 0xffff,
+			(__force u32)~csum_fold(l3) & 0xffff,
+			(__force u32)~csum_fold(l4) & 0xffff);
+		return;
+	}
+	/* CHECKSUM_COMPLETE covers the packet from skb->data */
+	case 2:
+		skb->csum = nhoff ? csum_add(hw, csum_partial(skb->data,
+							       nhoff, 0)) :
+				    hw;
+		break;
+	case 3:
+		skb->csum = csum_sub(hw,
+				     csum_partial(skb_mac_header(skb),
+						  skb->data -
+						  skb_mac_header(skb), 0));
+		break;
+	case 4:
+		skb->csum = csum_add(hw, csum_partial(skb->data, nhoff + ihl,
+						      0));
+		break;
+	default:
+		return;
+	}
+	skb->ip_summed = CHECKSUM_COMPLETE;
+}
+
 /* Always inline: with two callers gcc calls it out of line, per packet */
 static __always_inline void opip_rx_deliver(struct opip_group *group,
 					    struct net_device *dev,
@@ -562,10 +652,17 @@ static __always_inline void opip_rx_deli
 	if (unlikely((wqe->word2 & (OPIP_WQE2_NOT_IP | OPIP_WQE2_IP_EXC |
 				    OPIP_WQE2_IS_FRAG | OPIP_WQE2_L4_ERROR)) ||
 		     !(wqe->word2 & OPIP_WQE2_TCP_OR_UDP) || !csum_valid ||
-		     !(features & NETIF_F_RXCSUM)))
+		     !(features & NETIF_F_RXCSUM))) {
 		skb->ip_summed = CHECKSUM_NONE;
-	else
+		/* Experiment: the PIP's raw sum for an unverified IP packet */
+		if (unlikely(READ_ONCE(opip_hw_csum_complete)) && csum_valid &&
+		    (features & NETIF_F_RXCSUM) &&
+		    !(wqe->word2 & (OPIP_WQE2_NOT_IP | OPIP_WQE2_IP_EXC |
+				    OPIP_WQE2_RCV_ERROR)))
+			opip_rx_csum_complete(wqe, skb);
+	} else {
 		skb->ip_summed = CHECKSUM_UNNECESSARY;
+	}
 	napi_gro_receive(&group->napi, skb);
 }
 
