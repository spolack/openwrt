[ -n "$WIN" ] || { WIN=10; [ "$1" = full ] && WIN=5; }
PING6=; if ping -6 -c 1 -w 1 ::1 > /dev/null 2>&1; then PING6="ping -6"; elif have ping6; then PING6=ping6; fi
have devmem || { echo "devmem is missing: this needs the octeon-health test image"; exit 1; }
[ -d /sys/kernel/debug/octeon_pip ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null
mkdir -p "$BASE"
runs=$(ls -d "$BASE"/[0-9]* 2>/dev/null | wc -l)
STAMP=$(date +%Y%m%d-%H%M%S)
OUT=$BASE/$STAMP; mkdir -p "$OUT"
DEVS=$(opip_devs)
[ -n "$DEVS" ] || { echo "no octeon_pip ports"; exit 1; }
up=$(cut -d. -f1 /proc/uptime)
first=1-boot; { [ "$up" -gt 600 ] || [ "$runs" -gt 0 ]; } && first=1-now
{
	echo "# octeon-itus-debug $VERSION, $(cat /tmp/sysinfo/model 2>/dev/null || cat /proc/device-tree/model 2>/dev/null), $(uname -r), $STAMP"
	echo "mode ${1:-collect}; uptime ${up}s; earlier runs since boot $runs; window ${WIN}s per collection"
	for d in $DEVS; do printf '%s flags %s; ' "$d" "$(cat /sys/class/net/$d/flags)"; done; echo
} > "$OUT/summary.md"
DEVS_OK=
for d in $DEVS; do
	if [ $(( $(cat /sys/class/net/$d/flags) & 1 )) = 0 ]; then
		ip link set dev "$d" up && say "$d was down: brought up" && DEVS_OK=1
	fi
done
[ -n "$DEVS_OK" ] && { echo "ports brought up by the script, waited 8 s" >> "$OUT/summary.md"; sleep 8; }
say "collecting (about $((WIN + 10)) s per step) into $OUT"
static_info
collect "$first"
case "$1" in kick|full)
	say "experiment: autonegotiation restart (ethtool -r) on every port"; kick; collect 2-kick ;;
esac
MODE=$1
if [ "$1" = full ]; then
	stuck=; for d in $(linked 2-kick); do [ "$(cat /sys/class/net/$d/carrier 2>/dev/null)" = 1 ] || stuck="$stuck $d"; done
	set -- $stuck
	A=$1 B=$2
	if [ -z "$A" ]; then
		echo "" >> "$OUT/summary.md"; echo "every port with copper link has carrier after the kick: the PCS/bypass split is done on all ports anyway" >> "$OUT/summary.md"
		set -- $(linked 2-kick); A=$1 B=$2
	fi
	[ -n "$A" ] || A=$(echo $DEVS | cut -d' ' -f1)
	[ -n "$B" ] || B=$A
	say "experiment: PCS power cycle on $A, Marvell AN bypass off on $B"
	pcscycle "$A"; nobypass "$B"; sleep 6; collect "3-pcscycle-$A-nobypass-$B"
	say "experiment: both on every port, then an autonegotiation restart"
	for d in $DEVS; do pcscycle "$d"; done
	for d in $DEVS; do [ "$d" = "$B" ] || nobypass "$d"; done
	sleep 6; kick; collect 4-all
	say "experiment: a forced PHY interrupt"; forceint
fi
if [ "$1" = full ] || [ "$MODE" = full ]; then
	say "the PHY interrupt status registers (the read clears them)"
	intstatus > "$OUT/phy-intstatus.txt" 2>&1
	{ echo ""; echo "### PHY interrupt status at the end (19_0, 19_1, 19_4; first and second read)"; sed 's/^/    /' "$OUT/phy-intstatus.txt"; } >> "$OUT/summary.md"
fi
mask "$OUT"/*.txt "$OUT"/*/*.txt "$OUT/summary.md"
tar -C "$BASE" -czf "$BASE/octeon-itus-debug-$STAMP.tar.gz" "$STAMP" 2>/dev/null
echo
cat "$OUT/summary.md"
echo
echo "archive: $BASE/octeon-itus-debug-$STAMP.tar.gz (paste summary.md above, attach the archive)"
